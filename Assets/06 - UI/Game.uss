/* Both frames come from the "Wood and Paper UI" pack of Treasure Hunters,
   reassembled as 9-slice: the corners keep their size, the middle stretches. */

.wood-frame {
    background-image: url("Panel.png");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 2px;
}

/* --- Top bar: the counter on the left, the button on the right --- */

#bar {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px 32px;
}

#counter-frame {
    flex-shrink: 0;
    padding: 22px 76px 30px 76px;
}

#counter {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
}

#restart {
    flex-shrink: 0;
    white-space: nowrap;
    background-image: url("Button.png");
    -unity-slice-left: 14;
    -unity-slice-top: 14;
    -unity-slice-right: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 18px 44px 28px 44px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

#restart:hover {
    scale: 1.04 1.04;
}

/* --- End panel: one frame in the middle, nothing else --- */

#overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

#panel {
    padding: 52px 96px 64px 96px;
    align-items: center;
}

#title {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
}

#subtitle {
    margin-top: 14px;
    font-size: 24px;
    color: rgb(255, 238, 208);
}
