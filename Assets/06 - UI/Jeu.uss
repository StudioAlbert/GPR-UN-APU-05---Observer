/* Les deux cadres viennent du pack « Wood and Paper UI » de Treasure Hunters,
   réassemblés en 9-slice : les coins gardent leur taille, le milieu s'étire. */

.cadre-bois {
    background-image: url("Panneau.png");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 2;
}

/* --- Le bandeau du haut : le compteur à gauche, le bouton à droite --- */

#barre {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px 32px;
}

#cartouche {
    flex-shrink: 0;
    padding: 22px 76px 30px 76px;
}

#compteur {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
}

#recommencer {
    flex-shrink: 0;
    white-space: nowrap;
    background-image: url("Bouton.png");
    -unity-slice-left: 14;
    -unity-slice-top: 14;
    -unity-slice-right: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 2;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 18px 44px 28px 44px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

#recommencer:hover {
    scale: 1.04 1.04;
}

/* --- Le panneau de fin : un cadre au centre, rien d'autre --- */

#voile {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

#panneau {
    padding: 52px 96px 64px 96px;
    align-items: center;
}

#titre {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(255, 243, 214);
}

#sous-titre {
    margin-top: 14px;
    font-size: 24px;
    color: rgb(255, 238, 208);
}
